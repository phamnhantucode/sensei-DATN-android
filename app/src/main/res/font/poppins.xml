<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Thin 100 -->
    <font
        android:font="@font/poppins_thin"
        android:fontStyle="normal"
        android:fontWeight="100"
        app:font="@font/poppins_thin"
        app:fontStyle="normal"
        app:fontWeight="100" />

    <font
        android:font="@font/poppins_thin_italic"
        android:fontStyle="italic"
        android:fontWeight="100"
        app:font="@font/poppins_thin_italic"
        app:fontStyle="italic"
        app:fontWeight="100" />

    <!-- ExtraLight 200 -->
    <font
        android:font="@font/poppins_extra_light"
        android:fontStyle="normal"
        android:fontWeight="200"
        app:font="@font/poppins_extra_light"
        app:fontStyle="normal"
        app:fontWeight="200" />

    <font
        android:font="@font/poppins_extra_light_italic"
        android:fontStyle="italic"
        android:fontWeight="200"
        app:font="@font/poppins_extra_light_italic"
        app:fontStyle="italic"
        app:fontWeight="200" />

    <!-- Light 300 -->
    <font
        android:font="@font/poppins_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/poppins_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        android:font="@font/poppins_light_italic"
        android:fontStyle="italic"
        android:fontWeight="300"
        app:font="@font/poppins_light_italic"
        app:fontStyle="italic"
        app:fontWeight="300" />

    <!-- Regular 400 -->
    <font
        android:font="@font/poppins_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/poppins_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/poppins_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/poppins_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <!-- Medium 500 -->
    <font
        android:font="@font/poppins_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/poppins_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/poppins_medium_italic"
        android:fontStyle="italic"
        android:fontWeight="500"
        app:font="@font/poppins_medium_italic"
        app:fontStyle="italic"
        app:fontWeight="500" />

    <!-- SemiBold 600 -->
    <font
        android:font="@font/poppins_semi_bold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/poppins_semi_bold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/poppins_semi_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="600"
        app:font="@font/poppins_semi_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="600" />

    <!-- Bold 700 -->
    <font
        android:font="@font/poppins_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/poppins_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/poppins_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/poppins_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />

    <!-- ExtraBold 800 -->
    <font
        android:font="@font/poppins_extra_bold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/poppins_extra_bold"
        app:fontStyle="normal"
        app:fontWeight="800" />

    <font
        android:font="@font/poppins_extra_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="800"
        app:font="@font/poppins_extra_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="800" />

    <!-- Black 900 -->
    <font
        android:font="@font/poppins_black"
        android:fontStyle="normal"
        android:fontWeight="900"
        app:font="@font/poppins_black"
        app:fontStyle="normal"
        app:fontWeight="900" />

    <font
        android:font="@font/poppins_black_italic"
        android:fontStyle="italic"
        android:fontWeight="900"
        app:font="@font/poppins_black_italic"
        app:fontStyle="italic"
        app:fontWeight="900" />

</font-family>
